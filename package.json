{
  "name": "@hagicode/omniroute-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "import:upstream": "node scripts/import-english.mjs",
    "dev": "npm run import:upstream && astro dev",
