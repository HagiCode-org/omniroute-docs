---
import Search from "@astrojs/starlight/components/Search.astro";
import SiteTitle from "@astrojs/starlight/components/SiteTitle.astro";
import SocialIcons from "@astrojs/starlight/components/SocialIcons.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
import LanguageSelect from "./StarlightLanguageSelect.astro";
import { isSiteLocale, SITE_COPY } from "../i18n/site-copy.mjs";

const requested = Astro.locals.starlightRoute?.locale;
const locale = isSiteLocale(requested) ? requested : "en-US";
const copy = SITE_COPY[locale];
const productDocs = `https://docs.hagicode.com/${locale === "zh-CN" ? "" : `${locale}/`}`;
---
<div class="header">
  <div class="title-wrapper sl-flex"><SiteTitle /><LanguageSelect /></div>
  <div class="search print:hidden"><Search /></div>
  <nav class="related-links print:hidden" aria-label={copy.footerLabel}>
    <a href="https://www.hagicode.com/" aria-label={copy.websiteLabel}><span class="wide">{copy.websiteLabel}</span><span class="compact" aria-hidden="true">{copy.websiteCompactLabel}</span></a>
    <a href={productDocs} aria-label={copy.productDocsLabel}><span class="wide">{copy.productDocsLabel}</span><span class="compact" aria-hidden="true">{copy.productDocsCompactLabel}</span></a>
  </nav>
  <div class="sl-hidden md:sl-flex print:hidden right-group"><SocialIcons /><ThemeSelect /></div>
</div>
<style>
  @layer starlight.core {
    .header { display: flex; align-items: center; justify-content: space-between; gap: var(--sl-nav-gap); height: 100%; }
    .title-wrapper { min-width: 0; align-items: center; gap: .5rem; }
    .related-links { display: flex; gap: 1rem; font-size: var(--sl-text-sm); }
    .related-links a { display: inline-flex; min-height: 2.5rem; align-items: center; color: var(--sl-color-text); white-space: nowrap; }
    .related-links a:focus-visible { outline: 2px solid var(--sl-color-text-accent); }
    .compact { display: none; }
    .right-group { align-items: center; gap: 1rem; }
    @media (max-width: 50rem) {
      :global(html) { --sl-nav-height: 6.5rem; --sl-nav-pad-y: .5rem; }
      .header { display: grid; grid-template: "title search" "links links" / minmax(0, 1fr) auto; gap: .2rem .5rem; }
      .title-wrapper { grid-area: title; }
      .search { grid-area: search; }
      .related-links { grid-area: links; }
      .wide { display: none; }
      .compact { display: inline; }
    }
    @media (max-width: 30rem) { .header { grid-template-areas: "title title" "links search"; } }
  }
</style>
