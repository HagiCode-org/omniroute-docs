---
import EditLink from "@astrojs/starlight/components/EditLink.astro";
import LastUpdated from "@astrojs/starlight/components/LastUpdated.astro";
import Pagination from "@astrojs/starlight/components/Pagination.astro";
import { Icon } from "@astrojs/starlight/components";
import FloatingPromote from "./FloatingPromote.astro";
import HagiCodeEndCard from "./HagiCodeEndCard.astro";
import { isSiteLocale, LANGUAGE_OPTIONS, SITE_COPY } from "../i18n/site-copy.mjs";

const requested = Astro.locals.starlightRoute?.locale;
const locale = isSiteLocale(requested) ? requested : "en-US";
const copy = SITE_COPY[locale];
const sourceUrl = "https://github.com/HagiCode-org/omniroute-docs";
const productDocs = `https://docs.hagicode.com/${locale === "zh-CN" ? "" : `${locale}/`}`;
---
<HagiCodeEndCard />
<FloatingPromote />
<footer class="sl-flex site-footer">
  <div class="meta sl-flex"><EditLink /><LastUpdated /></div>
  <Pagination />
  <nav aria-label={copy.footerLabel}>
    {LANGUAGE_OPTIONS.map((option) => <a href={`/${option.code}/`} lang={option.lang} hreflang={option.lang} aria-label={SITE_COPY[option.code].homeLabel}>{option.label}</a>)}
    <a href="https://www.hagicode.com/">{copy.websiteLabel}</a>
    <a href={productDocs}>{copy.productDocsLabel}</a>
    <a href="https://tasks.hagicode.com/">{copy.hagiTaskLabel}</a>
    <a href={sourceUrl}><Icon name="github" /> {copy.sourceLabel}</a>
    <a href={`${sourceUrl}/issues`}>{copy.issuesLabel}</a>
  </nav>
  <p>© {new Date().getFullYear()} {copy.copyright}</p>
  <a class="kudos sl-flex" href="https://starlight.astro.build"><Icon name="starlight" /> {Astro.locals.t("builtWithStarlight.label")}</a>
</footer>
<style>
  @layer starlight.core {
    .site-footer { flex-direction: column; gap: 1rem; padding-block: 1.5rem; border-top: 1px solid var(--sl-color-gray-5); color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); }
    .meta { justify-content: space-between; flex-wrap: wrap; gap: .75rem; }
    nav { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; }
    a { display: inline-flex; align-items: center; min-height: 2.75rem; gap: .35rem; color: inherit; }
    a:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 3px; }
    p { margin: 0; }
    .kudos { justify-content: center; }
  }
</style>
