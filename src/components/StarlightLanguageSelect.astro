---
import { getCollection } from "astro:content";
import { isSiteLocale, LANGUAGE_OPTIONS, SITE_COPY } from "../i18n/site-copy.mjs";
import { getLocaleHref } from "../lib/locale-navigation.mjs";

const requested = Astro.locals.starlightRoute?.locale;
const locale = isSiteLocale(requested) ? requested : "en-US";
const copy = SITE_COPY[locale];
const ids = (await getCollection("docs")).map(({ id }) => id);
const choices = LANGUAGE_OPTIONS.map((option) => ({
  ...option,
  href: getLocaleHref(Astro.url.pathname, option.code, ids),
}));
const dialogId = `language-dialog-${crypto.randomUUID()}`;
---

<div class="language-control" data-language-chooser>
  <button class="language-trigger" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls={dialogId} aria-label={copy.languageControlLabel}>
    {copy.languageLabel} <span aria-hidden="true">⌄</span>
  </button>
  <dialog id={dialogId} class="language-dialog" aria-labelledby={`${dialogId}-title`}>
    <div class="language-dialog__header">
      <h2 id={`${dialogId}-title`}>{copy.dialogTitle}</h2>
      <form method="dialog"><button type="submit" aria-label={copy.closeLabel}>×</button></form>
    </div>
    <p>{copy.currentLocaleLabel}: {copy.languageLabel}</p>
    <ul>
      {choices.map((option) => <li><a href={option.href} data-locale={option.code} lang={option.lang} hreflang={option.lang} aria-current={option.code === locale ? "page" : undefined}>{option.label}</a></li>)}
    </ul>
  </dialog>
  <noscript><nav aria-label={copy.dialogTitle}><ul>{choices.map((option) => <li><a href={option.href} lang={option.lang} hreflang={option.lang}>{option.label}</a></li>)}</ul></nav></noscript>
</div>

<script>
  import { preserveUrlContext, writeBrowserLocalePreference } from "../lib/locale-navigation.mjs";
  document.querySelectorAll<HTMLElement>("[data-language-chooser]").forEach((chooser) => {
    const trigger = chooser.querySelector<HTMLButtonElement>(".language-trigger");
    const dialog = chooser.querySelector<HTMLDialogElement>(".language-dialog");
    if (!trigger || !dialog) return;
    trigger.addEventListener("click", () => {
      dialog.showModal();
      trigger.setAttribute("aria-expanded", "true");
      dialog.querySelector<HTMLElement>('[aria-current="page"]')?.focus();
    });
    dialog.addEventListener("close", () => {
      trigger.setAttribute("aria-expanded", "false");
      trigger.focus();
    });
    dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
    dialog.querySelectorAll<HTMLAnchorElement>("a[data-locale]").forEach((link) => {
      link.addEventListener("click", (event) => {
        if (link.getAttribute("aria-current") === "page") {
          event.preventDefault();
          dialog.close();
          return;
        }
        const targetLocale = link.dataset.locale;
        if (!targetLocale) throw new Error("Language option is missing its locale code.");
        event.preventDefault();
        writeBrowserLocalePreference(targetLocale);
        window.location.assign(preserveUrlContext(link.href, new URL(window.location.href)));
      });
    });
  });
</script>

<style>
  .language-trigger { min-height: 2.75rem; max-width: 10rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; background: transparent; color: var(--sl-color-text); border: 0; cursor: pointer; }
  .language-dialog { position: fixed; inset: 0; margin: auto; width: min(32rem, calc(100vw - 2rem)); max-height: 85dvh; padding: 1.25rem; overflow: auto; border: 1px solid var(--sl-color-gray-5); border-radius: var(--sl-radius-md); background: var(--sl-color-bg-nav); color: var(--sl-color-text); }
  .language-dialog::backdrop { background: rgb(0 0 0 / 55%); }
  .language-dialog__header { display: flex; justify-content: space-between; align-items: center; }
  .language-dialog h2 { margin: 0; }
  .language-dialog button { min-width: 2.75rem; min-height: 2.75rem; cursor: pointer; }
  .language-dialog ul, noscript ul { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: .5rem; padding: 0; list-style: none; }
  .language-dialog a, noscript a { display: block; padding: .75rem; border: 1px solid var(--sl-color-gray-5); border-radius: var(--sl-radius-sm); color: var(--sl-color-text); }
  .language-dialog a:hover, .language-dialog a[aria-current="page"] { border-color: var(--sl-color-text-accent); }
  .language-control :focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 2px; }
  noscript nav { position: absolute; z-index: 100; background: var(--sl-color-bg-nav); max-height: 70vh; overflow: auto; }
</style>
