---
import Head from "@astrojs/starlight/components/Head.astro";
import { getEnglishTopicHref } from "../lib/locale-navigation.mjs";

const route = Astro.locals.starlightRoute;
const fallback = route?.entry.data.isEnglishFallback === true;
if (fallback) {
  const canonical = new URL(getEnglishTopicHref(Astro.url.pathname), Astro.site ?? Astro.url).href;
  let foundCanonical = false;
  let foundOpenGraphUrl = false;
  let foundOpenGraphLocale = false;
  route.head = route.head
    .filter(({ tag, attrs }) => !(tag === "link" && attrs?.rel === "alternate"))
    .map((item) => {
      if (item.tag === "link" && item.attrs?.rel === "canonical") {
        foundCanonical = true;
        return { ...item, attrs: { ...item.attrs, href: canonical } };
      }
      if (item.tag === "meta" && item.attrs?.property === "og:url") {
        foundOpenGraphUrl = true;
        return { ...item, attrs: { ...item.attrs, content: canonical } };
      }
      if (item.tag === "meta" && item.attrs?.property === "og:locale") {
        foundOpenGraphLocale = true;
        return { ...item, attrs: { ...item.attrs, content: "en_US" } };
      }
      return item;
    });
  if (!foundCanonical) route.head.push({ tag: "link", attrs: { rel: "canonical", href: canonical } });
  if (!foundOpenGraphUrl) route.head.push({ tag: "meta", attrs: { property: "og:url", content: canonical } });
  if (!foundOpenGraphLocale) route.head.push({ tag: "meta", attrs: { property: "og:locale", content: "en_US" } });
}
---
<Head />
