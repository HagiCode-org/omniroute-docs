---
import MarkdownContent from "@hagicode/hagilight-starlight/MarkdownContent";
import { isSiteLocale, SITE_COPY } from "../i18n/site-copy.mjs";
import { getEnglishTopicHref } from "../lib/locale-navigation.mjs";

const route = Astro.locals.starlightRoute;
const locale = isSiteLocale(route?.locale) ? route.locale : "en-US";
const fallback = route?.entry.data.isEnglishFallback === true;
const aiDisclosures = {
  isAITranslation: false,
  isAIAuthor: false,
  sourceLocale: "en-US",
};
---
<MarkdownContent aiDisclosures={aiDisclosures}>
  {fallback && <aside class="english-fallback-notice">
    <p>{SITE_COPY[locale].englishFallbackNotice} <a href={getEnglishTopicHref(Astro.url.pathname)}>{SITE_COPY[locale].englishFallbackLinkLabel}</a></p>
  </aside>}
  {fallback ? <div lang="en-US"><slot /></div> : <slot />}
</MarkdownContent>
<style>
  .english-fallback-notice { margin-block-end: 1.5rem; padding: .75rem 1rem; border-inline-start: .25rem solid var(--sl-color-text-accent); background: var(--sl-color-gray-6); }
  .english-fallback-notice p { margin: 0; }
</style>
