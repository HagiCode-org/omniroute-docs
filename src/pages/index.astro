---
import RootTransit from "@hagicode/hagilight-core/RootTransit";
import { LANGUAGE_OPTIONS } from "../i18n/site-copy.mjs";

const links = LANGUAGE_OPTIONS.filter(({ code }) => code !== "en-US").map(({ code, label, lang }) => ({
  destination: `/${code}/`,
  label,
  lang,
}));
---

<RootTransit destination="/en-US/" siteName="OmniRoute Documentation" locale="en-US" links={links} />
