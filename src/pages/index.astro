<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://omniroute.hagicode.com/en-US/" />
    <title>OmniRoute Documentation</title>
  </head>
  <body>
    <p><a href="/en-US/">Continue to OmniRoute documentation</a></p>
    <script>
      import { preserveUrlContext, readBrowserLocalePreference } from "../lib/locale-navigation.mjs";
      const locale = readBrowserLocalePreference() ?? "en-US";
      window.location.replace(preserveUrlContext(`/${locale}/`, new URL(window.location.href)));
    </script>
  </body>
</html>
